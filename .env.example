# cdz configuration. Copy to .env (never commit it) and `chmod 600 .env`.
# Every key holder keeps an .env with ONLY their own keys; the coordinator's .env can hold none.

# --- network --------------------------------------------------------------------------------
CDZ_NETWORK=devnet                 # devnet | testnet | mainnet | path/to/profile.toml
CDZ_PARTY_FILE=party.json          # public party definition (cdz party new)
# Pin the global synchronizer id after checking `cdz status` (changes on hard migrations).
CDZ_SYNCHRONIZER_ID=

# --- JSON Ledger API of the node used for prepare/execute and reads -------------------------
CDZ_LEDGER_URL=http://localhost:7575
CDZ_LEDGER_USER=cdz-registrar      # ledger user with CanReadAs + CanExecuteAs on the party
# Either a static JWT ...
CDZ_LEDGER_TOKEN=
# ... or OAuth2 client credentials (Auth0 style)
CDZ_OAUTH_TOKEN_URL=
CDZ_OAUTH_CLIENT_ID=
CDZ_OAUTH_CLIENT_SECRET=
CDZ_OAUTH_AUDIENCE=
CDZ_OAUTH_SCOPE=

# --- participant Admin API (gRPC) for topology reads/writes ---------------------------------
CDZ_ADMIN_ADDR=localhost:5002      # e.g. kubectl port-forward to the participant
CDZ_ADMIN_TLS=false
CDZ_ADMIN_CA=
CDZ_ADMIN_CERT=                    # client certificate + key for mTLS (optional)
CDZ_ADMIN_KEY=

# --- DA Utilities (defaults come from the network profile) ----------------------------------
CDZ_UTILITIES_API=
CDZ_UTILITIES_OPERATOR=
CDZ_UTILITIES_TOKEN=

# --- keys held on THIS machine (1..n each) ---------------------------------------------------
# Value: base64 PKCS#8 DER, a PEM block, a 32-byte Ed25519 seed (hex/base64), or file:/path/key.pem
# Create with: cdz keys generate --role ns|tx --name <name> --env-out .env --pub-out <name>.pub.json
# Namespace keys: owners of the decentralized namespace (topology authority).
CDZ_NS_KEY_1=
# Party signing keys: m-of-n signatures on transactions (PartyToParticipant.party_signing_keys).
CDZ_TX_KEY_1=
